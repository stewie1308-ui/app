<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- The notebook margin line, coloured by topic. -->
    <TextView
        android:id="@+id/widget_bar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/widget_faded" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_topic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="Inkling"
            android:textColor="@color/widget_faded"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="2"
            android:text="@string/widget_empty_title"
            android:textColor="@color/widget_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="5"
            android:text="@string/widget_empty_body"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
